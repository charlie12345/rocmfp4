+f16_to_fast_us="$(extract_us 'type_src=f16,type_dst=q4_0_rocmfp4_fast,')"
+bf16_to_fast_us="$(extract_us 'type_src=bf16,type_dst=q4_0_rocmfp4_fast,')"
+fast_to_f32_us="$(extract_us 'type_src=q4_0_rocmfp4_fast,type_dst=f32,')"
