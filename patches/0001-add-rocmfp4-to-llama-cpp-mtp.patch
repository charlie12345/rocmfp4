+static __device__ __forceinline__ int8_t rocmfp4_decode_i8(uint8_t q) {
+    q &= 0x0f;
+    const int mag3 = q & 0x07;
+    const int mag = mag3 <= 4 ? mag3 : 2*mag3 - 4;
+    return (q & 0x08) ? -mag : mag;
+}
