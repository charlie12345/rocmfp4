+        --spec-draft-n-min "$SPEC_DRAFT_N_MIN" \
+        --spec-draft-p-min "$SPEC_DRAFT_P_MIN" \
+        --spec-draft-p-split "$SPEC_DRAFT_P_SPLIT" \
+        -n "$n_predict" \
+        -p "$prompt" 2>&1
