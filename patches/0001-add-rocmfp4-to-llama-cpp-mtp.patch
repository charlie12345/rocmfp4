+        } else {
+            ggml_cuda_memcpy_1<sizeof(q), 2>(&q, x[ib].qs + iqs + l0);
+        }
+        q = (q >> shift) & 0x0F0F0F0F;
+        v[l0/4] = rocmfp4_get_low_int_from_codebook_16(q, kvalues_rocmfp4);
