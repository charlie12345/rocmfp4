+            printf("FAIL: %s %.2f us/run exceeds max %.2f\n", label, got, max) > "/dev/stderr";
+            exit 1;
+        }
+        printf("PASS: %s %.2f us/run <= %.2f\n", label, got, max);
+    }'
+}
