+    GGML_ROCMFP4_FAST_Q8_1_MMVQ_VDR != 2 && \
+    GGML_ROCMFP4_FAST_Q8_1_MMVQ_VDR != 4
+#error "GGML_ROCMFP4_FAST_Q8_1_MMVQ_VDR must be 1, 2, or 4"
+#endif
